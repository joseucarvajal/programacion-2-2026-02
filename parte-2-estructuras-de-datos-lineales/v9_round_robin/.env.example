# Base de datos SQLite. Relativa al directorio donde se arranca el servidor.
DATABASE_URL=sqlite:///var/round_robin.db

# Pesos de la rotacion, en orden 0, 1, 2 (pago de deudas, contado, credito).
# Poniendo 1,1,1 se convierte en Round Robin puro.
ROUND_ROBIN_PESOS=3,2,1

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

TITULO=API de colas de la tienda - Round Robin
VERSION_API=1.0.0